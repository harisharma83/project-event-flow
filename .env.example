# This file is for running services directly on your HOST (node src/x.js),
# not inside Docker — when running via `docker compose up`, every service
# gets its DATABASE_URL/KAFKA_BROKERS injected directly in docker-compose.yml
# (pointing at the `postgres`/`kafka` service names), and those values
# override whatever's in this file.
DATABASE_URL=postgres://postgres:eventflow@localhost:5432/eventflow

# Week 6: changed from localhost:9092 to localhost:19092. Kafka/Redpanda
# now runs with TWO listeners — "internal" (kafka:9092, only reachable by
# other containers on the compose network) and "external" (localhost:19092,
# for host tools). If you still see localhost:9092 anywhere and get
# connection errors, that's why — 9092 is container-only now.
KAFKA_BROKERS=localhost:19092
KAFKA_CLIENT_ID=order-service
PORT=3000

# Week 4: controls the mock payment gateway's simulated reliability.
# off (default) | always | recovering | flaky — see src/paymentService.js
GATEWAY_FAILURE_MODE=off

# Week 5: Read Model Service's own REST API port (separate from Order
# Service's PORT above — both run at the same time).
READ_MODEL_PORT=3001
