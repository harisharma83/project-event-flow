DATABASE_URL=postgres://postgres:eventflow@localhost:5432/eventflow
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=order-service
PORT=3000

# Week 4: controls the mock payment gateway's simulated reliability.
# off (default) | always | recovering | flaky — see src/paymentService.js
GATEWAY_FAILURE_MODE=off

# Week 5: Read Model Service's own REST API port (separate from Order
# Service's PORT above — both run at the same time).
READ_MODEL_PORT=3001